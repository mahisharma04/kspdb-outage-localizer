# Copy to .env and adjust as needed. Every variable has a safe default, so the
# system runs with an empty .env.

# --- Storage -------------------------------------------------------------
# Default (unset) uses SQLite at /tmp/kspdb.db — zero external services.
# docker-compose sets this to the bundled Postgres automatically.
# DATABASE_URL=postgresql://kspdb:kspdb@db:5432/kspdb

# --- AI dispatch briefing (optional) -------------------------------------
# If unset, a deterministic template is used and the system works fully.
# Set a key to enable the LLM-phrased briefing. Any OpenAI-compatible endpoint.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Synthetic network shape (seed) --------------------------------------
# SEED_DTS=48
# SEED_TARGET_POLES=4200
# SEED_MISSING_TOPOLOGY_FRAC=0.60
# SEED_HARD_DTS=3
# SEED_RANDOM_SEED=7

# --- Detection tuning ----------------------------------------------------
# SILENCE_TIMEOUT_S=2000
# DEBOUNCE_S=4
# SCHEDULED_GRACE_S=2700
# RESTORE_FRACTION=0.6

# --- Serving -------------------------------------------------------------
# PORT=8000
# FRONTEND_DIST=/app/frontend/dist
